---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/sections/HomeHero.astro";
import CompanyIntro from "../components/sections/CompanyIntro.astro";
import RubrosShowcase from "../components/sections/RubrosShowcase.astro";
import BlogPreview from "../components/sections/BlogPreview.astro";
import ContactSection from "../components/sections/ContactSection.astro";
---

<BaseLayout>
  <main>
    <HomeHero />
    <CompanyIntro />
    <RubrosShowcase />
    <BlogPreview />
    <ContactSection />

    <footer class="site-footer-industrial">
      <div class="site-footer-industrial__inner">
        <a href="/" class="site-footer-industrial__brand" aria-label="Daniel Moras - Inicio">
          <img src="/images/logo-daniel-moras.png" alt="Daniel Moras" />
        </a>

        <nav aria-label="Navegación de cierre">
          <a href="/">Inicio</a>
          <a href="/#rubros">Rubros</a>
          <a href="/insumos">Insumos</a>
          <a href="/blog">Blog</a>
          <a href="/#contacto">Contacto</a>
        </nav>

        <p>
          Sitio desarrollado por <strong>Ambraco</strong>.
        </p>
      </div>
    </footer>
  </main>
</BaseLayout>