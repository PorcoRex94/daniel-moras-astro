---
import Container from "../ui/Container.astro";

const milestones = [
  {
    value: "1988",
    title: "MORAS & Cia.",
    text: "Comienzos vinculados al mercado gráfico.",
  },
  {
    value: "1994",
    title: "Tecnología Inkjet",
    text: "Eco-solvente, solvente, UV y base agua.",
  },
  {
    value: "ISD S.A.",
    title: "Soluciones integrales",
    text: "Equipos, finishing, corte, láser, tintas y partes.",
  },
  {
    value: "Soporte",
    title: "Acompañamiento técnico",
    text: "Atención directa y recursos especializados de campo.",
  },
];
---

<section class="company-intro" id="quienes-somos" aria-labelledby="company-intro-title">
  <Container class="company-intro__container">
    <div class="company-intro__editorial">
      <div class="company-intro__copy">
        <p class="company-intro__eyebrow">Daniel Moras · junto a ISD S.A.</p>
        <h2 id="company-intro-title">Trayectoria y respaldo para elegir tecnología de impresión.</h2>

        <p>
          Mis comienzos en el área gráfica datan de 1988 en MORAS &amp; Cia. Hoy,
          junto a ISD S.A., formo parte de una empresa con recursos técnicos
          experimentados y una larga trayectoria en tecnología Inkjet.
        </p>

        <p>
          El recorrido institucional registra la instalación del primer equipo
          Inkjet GrandJet de Scitex Vision en Argentina y América Latina. Desde
          1994 trabajamos con tecnología Inkjet en sus variantes eco-solvente,
          solvente, UV y base agua.
        </p>

        <p>
          Ofrecemos equipos Inkjet Mimaki, Allwin, Apex, Flora y HD Digital,
          además de soluciones de finishing, mesas de corte Iecho y Saga,
          sistemas láser, tintas, partes e insumos.
        </p>

        <p>
          Ponemos toda nuestra experiencia a tu servicio, con atención directa,
          respaldo técnico y acompañamiento según las necesidades reales de cada
          proyecto.
        </p>

        <a class="company-intro__link" href="#rubros">
          Explorar soluciones por industria
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <aside class="company-intro__visual" aria-label="Trayectoria institucional Daniel Moras">
        <div class="company-intro__visual-heading">
          <p>Trayectoria documentada</p>
          <span>1988 — hoy</span>
        </div>

        <ol class="company-intro__visual-timeline">
          <li>
            <span>1988</span>
            <div>
              <small>Origen</small>
              <strong>MORAS &amp; Cia.</strong>
              <p>Comienzos en el mercado gráfico.</p>
            </div>
          </li>
          <li>
            <span>1994</span>
            <div>
              <small>Inkjet</small>
              <strong>Nuevas tecnologías</strong>
              <p>Eco-solvente, solvente, UV y base agua.</p>
            </div>
          </li>
          <li>
            <span>Hoy</span>
            <div>
              <small>Integración</small>
              <strong>Daniel Moras + ISD S.A.</strong>
              <p>Soluciones, insumos y soporte técnico.</p>
            </div>
          </li>
        </ol>

        <p class="company-intro__visual-note">
          Tecnología, aplicación y acompañamiento técnico bajo una misma mirada.
        </p>
      </aside>
    </div>

    <div class="company-intro__milestones" aria-label="Trayectoria y experiencia">
      {
        milestones.map((milestone) => (
          <article class="company-intro__milestone">
            <strong>{milestone.value}</strong>
            <div>
              <h3>{milestone.title}</h3>
              <p>{milestone.text}</p>
            </div>
          </article>
        ))
      }
    </div>

    <!-- La referencia histórica "25 años" y la promesa de respuesta en "24 hs"
      se conservaron en Git, pero no se presentan hasta contar con validación comercial. -->
  </Container>
</section>
