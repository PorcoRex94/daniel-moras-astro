---
import Container from "../ui/Container.astro";

const rubros = [
  {
    title: "Comunicación visual",
    eyebrow: "Gráfica, cartelería y aplicaciones UV",
    description:
      "Tecnología para gráfica visual, cartelería, rígidos y aplicaciones de alto impacto.",
    href: "/rubros/comunicacion-visual",
    image: "/images/rubros/cvisual.webp",
    imageAlt: "Aplicación de comunicación visual",
  },
  {
    title: "Tintas e insumos",
    eyebrow: "Continuidad y calidad de impresión",
    description:
      "Tintas, partes e insumos para sostener la calidad, cuidar equipos y mantener activa la producción.",
    href: "/insumos",
    image: "/images/rubros/tintas-insumos.webp",
    imageAlt: "Tintas e insumos para impresión",
  },
  {
    title: "Etiquetas",
    eyebrow: "Precisión para datos variables y series cortas",
    description:
      "Equipos para etiquetas profesionales, alta definición, producción flexible y terminación.",
    href: "/rubros/etiquetas",
    image: "/images/rubros/etiquetas.webp",
    imageAlt: "Aplicación para impresión de etiquetas",
  },
  {
    title: "Textil",
    eyebrow: "Sublimación, DTF e impresión directa",
    description:
      "Soluciones para producir sobre prendas, rollos, telas y materiales sublimables con continuidad.",
    href: "/rubros/textil",
    image: "/images/rubros/textil.webp",
    imageAlt: "Aplicación de producción textil",
  },
  {
    title: "Packaging",
    eyebrow: "Envases, displays y materiales rígidos",
    description:
      "Tecnología digital para packaging, envases, cartón, materiales rígidos y producción personalizada.",
    href: "/rubros/packaging",
    image: "/images/rubros/packaging.webp",
    imageAlt: "Aplicación de packaging",
  },
  {
    title: "Editorial",
    eyebrow: "Producción Inkjet y tiradas flexibles",
    description:
      "Soluciones para producción editorial, impresión bajo demanda, libros y procesos de alta eficiencia.",
    href: "/rubros/editorial",
    image: "/images/rubros/editorial.webp",
    imageAlt: "Aplicación de producción editorial",
  },
];
---

<section class="rubros-featured" id="rubros" aria-labelledby="rubros-title">
  <Container>
    <header class="rubros-featured__heading">
      <div class="rubros-featured__intro">
        <h2 id="rubros-title">Soluciones según tu producción.</h2>
        <p>
          Cada rubro combina materiales, tiempos, volúmenes y terminaciones
          diferentes. Explorá las soluciones según la aplicación que necesitás
          resolver.
        </p>
      </div>
    </header>

    <div class="rubros-featured__grid">
      {
        rubros.map((rubro, index) => (
          <article class="rubro-card">
            <a href={rubro.href} class="rubro-card__link">
              <div class="rubro-card__media">
                <span class="rubro-card__number" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <img
                  src={rubro.image}
                  alt={rubro.imageAlt}
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="rubro-card__content">
                <p class="rubro-card__eyebrow">{rubro.eyebrow}</p>
                <h3>{rubro.title}</h3>
                <p class="rubro-card__description">{rubro.description}</p>

                <span class="rubro-card__action">
                  Explorar soluciones
                  <span aria-hidden="true">↗</span>
                </span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </Container>
</section>
