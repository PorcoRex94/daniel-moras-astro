---
import Container from "../ui/Container.astro";
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero__media" aria-hidden="true">
    <img
      src="/images/hero/home-hero-bg.webp"
      alt=""
      width="1920"
      height="1440"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="home-hero__veil"></div>

  <Container class="home-hero__inner">
    <div class="home-hero__content">
      <p class="home-hero__eyebrow">
        Soluciones para impresión industrial
      </p>

      <h1 id="home-hero-title">
        Equipos y tecnología para impresión industrial.
      </h1>

      <p class="home-hero__lead">
        Equipos, tintas, insumos y asesoramiento técnico para planificar,
        producir y sostener cada operación con mejor criterio.
      </p>

      <div class="home-hero__actions">
        <a href="#rubros" class="home-hero__action home-hero__action--primary">
          Explorar soluciones
          <span aria-hidden="true">↓</span>
        </a>

        <a href="#contacto" class="home-hero__action home-hero__action--secondary">
          Consultar con un especialista
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

  </Container>
</section>
