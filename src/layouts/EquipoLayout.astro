---
import BaseLayout from "./BaseLayout.astro";
import { getEquiposRelacionados } from "../data/equiposIndex";
import { getSiteUrl } from "../lib/site-url.js";

const { equipo } = Astro.props;

const siteUrl = getSiteUrl(Astro.site);

const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

const rubroLabels = {
  textil: "Industria textil",
  packaging: "Packaging",
  comunicacionVisual: "Comunicación visual",
  etiquetas: "Etiquetas",
  editorial: "Editorial",
};

const rubroUrls = {
  textil: "/rubros/textil",
  packaging: "/rubros/packaging",
  comunicacionVisual: "/rubros/comunicacion-visual",
  etiquetas: "/rubros/etiquetas",
  editorial: "/rubros/editorial",
};

const formatLabel = (value = "") =>
  value
    .replace(/-/g, " ")
    .replace(/\b\w/g, (letter) => letter.toUpperCase());

const familyLabel = formatLabel(equipo.family);
const subgroupLabel = formatLabel(equipo.subgroup);

const relatedEquipment = getEquiposRelacionados(equipo, 3);

const title = `${equipo.name} | ${equipo.brand} | Daniel Moras`;

const description =
  equipo.metaDescription ??
  equipo.longDescription ??
  equipo.shortDescription ??
  `Información técnica y consulta comercial por ${equipo.name}.`;

const applications = (equipo.applications ?? []).map((item) =>
  typeof item === "string" ? { title: item, text: "" } : item,
);

const features = (equipo.features ?? []).map((item) =>
  typeof item === "string" ? { title: "", text: item } : item,
);

const consultationNotes = equipo.consultationNotes ?? [
  "Material o sustrato a trabajar.",
  "Formato requerido.",
  "Volumen estimado de producción.",
  "Tipo de terminación posterior.",
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    name: title,
    description,
    url: pageUrl,
    image: new URL(equipo.image, siteUrl).toString(),
    inLanguage: "es-AR",
    about: {
      "@type": "Thing",
      name: `${equipo.brand} ${equipo.name}`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Inicio",
        item: siteUrl,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Equipos",
        item: `${siteUrl}/equipos`,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: equipo.name,
        item: pageUrl,
      },
    ],
  },
];

const contactHref = `/#contacto?equipo=${encodeURIComponent(equipo.name)}`;
---

<BaseLayout
  title={title}
  description={description}
  image={equipo.image}
  type="article"
  schema={schema}
>
  <main class="equipo-page equipo-page--compact">
    <section class="equipo-hero equipo-hero--compact-product">
      <div class="equipo-product-shell">
        <nav class="equipo-breadcrumbs equipo-product-shell__breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Inicio</a>
          <span aria-hidden="true">/</span>
          <a href="/equipos">Equipos</a>
          <span aria-hidden="true">/</span>
          <strong>{equipo.name}</strong>
        </nav>

        <div class="equipo-product-hero">
          <div class="equipo-product-hero__label">
            <p class="equipo-eyebrow">
              {rubroLabels[equipo.rubro]} · {equipo.brand}
            </p>
          </div>

          <div class="equipo-product-hero__text">
            <h1>{equipo.name}</h1>

            <p class="equipo-product-hero__description">
              {equipo.longDescription ?? equipo.shortDescription}
            </p>

            <div class="equipo-product-hero__actions">
              <a href={contactHref} class="equipo-button equipo-button--primary">
                Consultar por este equipo
              </a>

              {
                equipo.pdf && (
                  <a
                    href={equipo.pdf}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="equipo-button equipo-button--secondary"
                  >
                    Ver ficha técnica
                  </a>
                )
              }
            </div>
          </div>

          <div class="equipo-product-hero__visual">
            <div class="equipo-product-hero__glow"></div>

            <img
              src={equipo.image}
              alt={`${equipo.name}, equipo de ${equipo.brand}`}
              width="1400"
              height="820"
              loading="eager"
              decoding="async"
            />

            <div class="equipo-product-hero__shadow"></div>
          </div>
        </div>

        <div class="equipo-product-meta" aria-label="Datos rápidos del equipo">
          <article>
            <span>Marca</span>
            <strong>{equipo.brand}</strong>
          </article>

          <article>
            <span>Rubro</span>
            <a href={rubroUrls[equipo.rubro]}>
              {rubroLabels[equipo.rubro]}
            </a>
          </article>

          <article>
            <span>Familia</span>
            <strong>{familyLabel}</strong>
          </article>

          <article>
            <span>Aplicación</span>
            <strong>{subgroupLabel}</strong>
          </article>

          <article>
            <span>Ficha técnica</span>
            {
              equipo.pdf ? (
                <a href={equipo.pdf} target="_blank" rel="noopener noreferrer">
                  Disponible
                </a>
              ) : (
                <strong>A consultar</strong>
              )
            }
          </article>
        </div>
      </div>
    </section>

    {
      (applications.length > 0 || features.length > 0) && (
        <section class="equipo-insights">
          <div class="equipo-insights__inner">
            <header class="equipo-insights__heading">
              <p class="equipo-eyebrow">Aplicaciones y criterios</p>

              <h2>Qué puede resolver y qué conviene evaluar antes de avanzar.</h2>

                <p>
                  La recomendación final depende del material, el volumen, el formato de
                  trabajo, la terminación posterior y el proceso actual de producción. También
                  conviene considerar tiempos de respuesta, cambios entre trabajos, integración
                  con corte o finishing, disponibilidad de insumos y el tipo de resultado que se
                  necesita sostener en el día a día.
                </p>
            </header>

            <div class="equipo-insights__layout">
              {
                applications.length > 0 && (
                  <div class="equipo-insights__block equipo-insights__block--applications">
                    <div class="equipo-insights__block-heading">
                      <span>01</span>
                      <div>
                        <h3>Producción posible</h3>
                        <p>Aplicaciones donde este equipo puede aportar valor.</p>
                      </div>
                    </div>

                    <div class="equipo-insights__cards">
                      {applications.map((item) => (
                        <article class="equipo-insight-card">
                          <span aria-hidden="true">✓</span>

                          <div>
                            <h4>{item.title}</h4>
                            {item.text && <p>{item.text}</p>}
                          </div>
                        </article>
                      ))}
                    </div>
                  </div>
                )
              }

              {
                features.length > 0 && (
                  <aside class="equipo-insights__block equipo-insights__block--features">
                    <div class="equipo-insights__block-heading">
                      <span>02</span>
                      <div>
                        <h3>Puntos principales</h3>
                        <p>Criterios técnicos y comerciales para comparar.</p>
                      </div>
                    </div>

                    <div class="equipo-feature-stack">
                      {features.map((item, index) => (
                        <article>
                          <span>{String(index + 1).padStart(2, "0")}</span>

                          <div>
                            {item.title && <h4>{item.title}</h4>}
                            <p>{item.text}</p>
                          </div>
                        </article>
                      ))}
                    </div>
                  </aside>
                )
              }
            </div>

            <div class="equipo-consult-panel">
              <header>
                <span>Para orientar mejor la consulta</span>
                <h3>Datos útiles antes de recomendar una configuración.</h3>
              </header>

              <div class="equipo-consult-panel__grid">
                {consultationNotes.slice(0, 6).map((item, index) => (
                  <article>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <p>{item}</p>
                  </article>
                ))}
              </div>
            </div>
          </div>
        </section>
      )
    }

    {
      equipo.video && (
        <section class="equipo-section equipo-section--compact-video">
          <div class="equipo-section__inner">
            <header class="equipo-section__heading">
              <p class="equipo-eyebrow">Video</p>

              <h2>Material audiovisual del equipo.</h2>
            </header>

            <div class="equipo-video">
              <iframe
                src={equipo.video}
                title={`Video de ${equipo.name}`}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              />
            </div>
          </div>
        </section>
      )
    }

    {
      relatedEquipment.length > 0 && (
        <section class="equipo-section equipo-section--compact-related">
          <div class="equipo-section__inner">
            <header class="equipo-section__heading">
              <p class="equipo-eyebrow">También puede interesarte</p>

              <h2>Otros equipos del mismo rubro.</h2>
            </header>

            <div class="equipo-related__grid">
              {relatedEquipment.map((item) => (
                <a href={`/equipos/${item.id}`} class="equipo-related-card">
                  <div class="equipo-related-card__image">
                    <img
                      src={item.image}
                      alt={`${item.name}, equipo de ${item.brand}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>

                  <span>{item.brand}</span>
                  <strong>{item.name}</strong>
                  <p>{item.shortDescription}</p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="equipo-final-cta equipo-final-cta--compact">
      <div class="equipo-final-cta__inner">
        <p class="equipo-eyebrow">{equipo.brand}</p>

        <h2>Contanos qué necesitás producir y evaluamos si este equipo encaja.</h2>

        <p>
          Con algunos datos sobre material, volumen, formato y terminación,
          podemos orientar mejor la consulta.
        </p>

        <a href={contactHref}>Hacer una consulta</a>
      </div>
    </section>

  </main>
</BaseLayout>
