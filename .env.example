# URL absoluta del entorno que genera el build. En revisión puede ser un subdominio temporal.
SITE_URL=

# Mantener false en revisión, incluso cuando SITE_URL apunte a un subdominio temporal.
# Cambiar a true únicamente al publicar el dominio definitivo con autorización comercial.
SITE_INDEXING=false

# URL HTTPS de un endpoint comercial que procese la consulta en el servidor.
# No colocar destinatarios, claves API ni contraseñas en variables PUBLIC_.
PUBLIC_CONTACT_FORM_ENDPOINT=

# Número comercial internacional de WhatsApp, únicamente dígitos (ej.: 54911...).
# Dejar vacío hasta que se confirme el número autorizado.
PUBLIC_WHATSAPP_NUMBER=
